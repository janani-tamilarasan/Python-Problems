        "### 1. While Loop"
      ],
      "metadata": {
        "id": "ZjSRPMAJxoPd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ### Example 1: Print n numbers\n",
        "\n",
        "n = int(input('Enter the n: '))\n",
        "while n > 0:\n",
        "  print(n)\n",
        "  n -=1\n",
        "print\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "i7IH8OE2y6H5",
        "outputId": "b2a59bad-0a32-4ea8-9237-6e9f91497568"
      },
      "execution_count": 39,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Enter the n: 5\n",
            "5\n",
            "4\n",
            "3\n",
            "2\n",
            "1\n"
          ]
        },
        {
          "output_type": "execute_result",
