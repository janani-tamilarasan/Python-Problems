        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ### Example 2:Countdown Timer\n",
        "count = 5\n",
        "while count > 0:\n",
        "    print(count)\n",
        "    count -= 1\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "35IeemIExujy",
        "outputId": "2d8dc75a-1a6d-4e51-af2a-b5466d5ff3b8"
      },
      "execution_count": 40,
      "outputs": [
        {
