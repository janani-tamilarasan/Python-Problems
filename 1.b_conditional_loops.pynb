    {
      "cell_type": "markdown",
      "source": [
        "## 8. Break Statement"
      ],
      "metadata": {
        "id": "VZmygy4D68en"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Example 1: Stop at Number 5\n",
        "\n",
        "for i in range(1, 11):\n",
        "    if i == 5:\n",
        "        break\n",
        "    print(i)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "8Sv3bD1U6__4",
        "outputId": "a0de568c-4ad1-4694-ba1a-69f06e68cce0"
      },
      "execution_count": 50,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "1\n",
            "2\n",
            "3\n",
            "4\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Continue Statement"
      ],
      "metadata": {
        "id": "zbcMhfOb7IWo"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "## Skip Number 3\n",
        "for i in range(1, 6):\n",
        "    if i == 3:\n",
        "        continue\n",
        "    print(i)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "biLlQydi7L6m",
        "outputId": "034421da-80c9-492d-b08e-311738037f37"
      },
      "execution_count": 51,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "1\n",
            "2\n",
            "4\n",
            "5\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## For Loop with not in Operator"
      ],
      "metadata": {
        "id": "V0hMjoEc7WEW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "subjects = [\"Maths\", \"Science\"]\n",
        "\n",
        "for subject in [\"Maths\", \"Science\", \"English\"]:\n",
        "    if subject not in subjects:\n",
        "        print(subject)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "vpdBYyio7aR_",
        "outputId": "e7ada956-a596-46e2-b2e8-e1605ab7c0be"
      },
      "execution_count": 52,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "English\n"
          ]
        }
      ]
    }
  ]
