    {
      "cell_type": "markdown",
      "source": [
        "\n",
        "### 2. For Loop"
      ],
      "metadata": {
        "id": "ETNrvAoiyl_s"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#Example 1: Print Student Names\n",
        "students = ['Ann','Vishwa', 'Janani']\n",
        "\n",
        "for student in students:\n",
        "  print(f\" student name is {student}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "hsUvaCqAzaoN",
        "outputId": "a1122e85-ff18-4cf1-d4b5-0495f12d1628"
      },
      "execution_count": 41,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            " student name is Ann\n",
            " student name is Vishwa\n",
            " student name is Janani\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Example 2: Print Numbers 1 to 5\n",
        "# Note -> Range doesn't inlcude last value, prints in 1 to 4 not 5\n",
        "\n",
        "for num in range(1,5):\n",
        "  print(num)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "nlgB9hqhz5EK",
        "outputId": "f0ea138a-a3b2-4101-cd62-81d1351bcab9"
      },
      "execution_count": 42,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "1\n",
            "2\n",
            "3\n",
            "4\n"
          ]
        }
      ]
