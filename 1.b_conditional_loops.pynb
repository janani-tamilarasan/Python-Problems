      },
      "execution_count": 46,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Wait\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 5. User Defined Functions (Without Loop or If)"
      ],
      "metadata": {
        "id": "LJCgCj3Y2iOO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Example 1: Add Two Numbers\n",
        "\n",
        "def add(a,b):\n",
        "  return a + b\n",
        "\n",
        "add(1,2)"
      ],
      "metadata": {
        "colab": {
