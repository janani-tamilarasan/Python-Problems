    {
      "cell_type": "markdown",
      "source": [
        "## 3. If Else"
      ],
      "metadata": {
        "id": "0EI_1Xkp0UsC"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "## Example 1: Voting Eligibility\n",
        "age = int(input(\"Enter your age: \"))\n",
        "\n",
        "if age >= 18:\n",
        " print('You are eligible for vote')\n",
        "else:\n",
        " print(\"You are not eligible for vote\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5SntQTw00Y8J",
        "outputId": "a1afc32f-8782-4523-a054-3a7bbf6b1e6e"
      },
      "execution_count": 43,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Enter your age: 20\n",
            "You are eligible for vote\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Example 2: Pass or Fail\n",
        "eligible_marks_to_pass = int(input(\"Enter elgible marks to pass: \"))\n",
        "marks_obtained =  int(input(\"Enter your marks: \"))\n",
        "\n",
        "if marks_obtained > eligible_marks_to_pass:\n",
        "  print('You are pass')\n",
        "else:\n",
        "  print('You are fail')\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "eWk5q5s406VT",
        "outputId": "a0583fb1-5807-4fbc-ad4e-f5ae2829ecdd"
      },
      "execution_count": 44,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Enter elgible marks to pass: 20\n",
            "Enter your marks: 100\n",
            "You are pass\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 4. If Elif Else"
      ],
      "metadata": {
        "id": "xCfF9vr52IVZ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Example 1: Grade Calculator\n",
        "mark = 82\n",
        "\n",
        "if mark >= 90:\n",
        "    print(\"Grade A\")\n",
        "elif mark >= 75:\n",
        "    print(\"Grade B\")\n",
        "else:\n",
        "    print(\"Grade C\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5_fQf_Z42Nh9",
        "outputId": "0c011021-9826-45cc-dd7a-3ce8d674e840"
      },
      "execution_count": 45,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Grade B\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Example 2: Traffic Signal\n",
        "signal = \"yellow\"\n",
        "\n",
        "if signal == \"green\":\n",
        "    print(\"Go\")\n",
        "elif signal == \"yellow\":\n",
        "    print(\"Wait\")\n",
        "else:\n",
        "    print(\"Stop\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "HbJVi_Nu2Ny1",
