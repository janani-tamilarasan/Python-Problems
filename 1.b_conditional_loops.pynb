    {
      "cell_type": "markdown",
      "source": [
        "## User Defined Functions with For Loop"
      ],
      "metadata": {
        "id": "VIopVuBw5ufW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "## Example 1: Print numbers\n",
        "def print_fruits_with_index():\n",
        "  fruits = [\"Apple\", \"Banana\", \"Mango\"]\n",
        "\n",
        "  for i in range(len(fruits)):\n",
        "      print(i, fruits[i])\n",
        "\n",
        "# main method\n",
        "print_fruits_with_index()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9Xbyqovd5t59",
        "outputId": "0d75a186-a90e-4701-d197-1ea9a94fe703"
      },
      "execution_count": 49,
      "outputs": [
        {
          "output_type": "stream",
